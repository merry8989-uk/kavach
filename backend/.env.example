# Kavach backend — environment template.
# Copy to .env and fill in. NEVER commit the real .env.

# Postgres in production. SQLite is fine for local dev and tests.
DATABASE_URL=postgresql+psycopg://kavach:kavach@localhost:5432/kavach

# Bearer token for API access. Generate a long random value.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
API_TOKEN=replace-me-with-a-long-random-value

# Requests per minute per token.
RATE_LIMIT_PER_MINUTE=60

# Versioned scoring rules.
SCORING_RULE_VERSION=2026-01

# AI providers. Leave unset to have the AI endpoints return 503 (they will
# never fabricate a result).
ASR_PROVIDER_URL=
ASR_PROVIDER_KEY=
LLM_PROVIDER_URL=
LLM_PROVIDER_KEY=

# Create tables on startup. Set false in production and run Alembic instead.
AUTO_CREATE_TABLES=false
