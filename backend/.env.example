# Kavach server — environment template.
# Copy to .env, fill it in, then:  chmod 600 .env
#
# NEVER commit the real .env. In production the server refuses to start while
# any value below is still a development default.

# ------------------------------------------------------------------ required --

# "production" turns on the safety checks described at the bottom of this file.
ENVIRONMENT=production

# Postgres. The compose file builds this from POSTGRES_* for you.
DATABASE_URL=postgresql+psycopg://kavach:CHANGE_THIS@localhost:5432/kavach

# Bearer token the app sends, and the same value you paste into
# Kavach -> Settings -> Server -> API token.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
API_TOKEN=replace-me-with-a-long-random-value

# HMAC key for phone hashing. Changing it invalidates every stored hash.
PHONE_PEPPER=replace-me-with-a-long-random-value

# Signs per-user login tokens. Changing it signs everyone out.
JWT_SECRET=replace-me-with-a-long-random-value

# ------------------------------------------------------------------ compose ---

POSTGRES_USER=kavach
POSTGRES_PASSWORD=CHANGE_THIS_DB_PASSWORD
POSTGRES_DB=kavach
API_PORT=8000
KAVACH_IMAGE=ghcr.io/merry8989-uk/kavach-server:latest

# ------------------------------------------------------------------- tuning ---

RATE_LIMIT_PER_MINUTE=60
SCORING_RULE_VERSION=2026-01

# ------------------------------------------------------------------ optional --

# AI providers. Leave unset and the AI endpoints return 503 rather than
# fabricating a result.
ASR_PROVIDER_URL=
ASR_PROVIDER_KEY=
LLM_PROVIDER_URL=
LLM_PROVIDER_KEY=

# ------------------------------------------------------------------- safety ---

# Leave both false in production.
AUTO_CREATE_TABLES=false
OTP_DEBUG_RETURN=false

# The server exits with a list of problems if, in production, any of these hold:
#   - API_TOKEN is empty, a default, or shorter than 24 characters
#   - PHONE_PEPPER is a default or shorter than 16 characters
#   - JWT_SECRET is a default
#   - AUTO_CREATE_TABLES is true
#   - DATABASE_URL points at SQLite
#   - OTP_DEBUG_RETURN is true
