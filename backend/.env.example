# Kavach server — environment template.
# Copy to .env, fill it in, then:  chmod 600 .env
#
# NEVER commit the real .env. In production the server refuses to start while
# any value below is still a development default.

# ------------------------------------------------------------------ required --

# "production" turns on the safety checks described at the bottom of this file.
ENVIRONMENT=production

# Postgres. The compose file builds this from POSTGRES_* for you.
DATABASE_URL=postgresql+psycopg://kavach:CHANGE_THIS@localhost:5432/kavach

# The shared bootstrap token: the value you paste into
# Kavach -> Settings -> Server. It ships in the APK, so treat it as public — it
# can only register an install, and everything else needs the per-install token
# the app gets back from POST /v1/app/register.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
API_TOKEN=replace-me-with-a-long-random-value

# Server-only credential for moderation and telemetry purge.
#
# **Must be different from API_TOKEN.** API_TOKEN ships in the APK as the
# bootstrap token, so using it for admin operations hands the moderation queue to
# anyone who extracts it from an install. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_TOKEN=

# Development only. Accepting the shared token on every endpoint is what the old
# client contract did, and it makes the token in the APK a full API key again.
# The production guard refuses to start with this on.
ALLOW_SHARED_TOKEN=false

# HMAC key for phone hashing. Changing it invalidates every stored hash.
PHONE_PEPPER=replace-me-with-a-long-random-value

# Signs per-user login tokens. Changing it signs everyone out.
JWT_SECRET=replace-me-with-a-long-random-value

# ------------------------------------------------------------------ compose ---

POSTGRES_USER=kavach
POSTGRES_PASSWORD=CHANGE_THIS_DB_PASSWORD
POSTGRES_DB=kavach
API_PORT=8000
KAVACH_IMAGE=ghcr.io/merry8989-uk/kavach-server:latest

# ------------------------------------------------------------------- tuning ---

RATE_LIMIT_PER_MINUTE=60
SCORING_RULE_VERSION=2026-01

# --------------------------------------------------------------- rate limit --
# Shared across replicas when set. Without it the limiter is per-process, so
# with N replicas the effective limit is N times RATE_LIMIT_PER_MINUTE.
# The live backend is reported by GET /health/ready.
REDIS_URL=

# ------------------------------------------------------------ SMS (required) --
# Sign-in cannot deliver a code without one of these, so the server refuses to
# start in production while SMS_PROVIDER is "none".
#   msg91  — India. Needs a DLT-approved template (TRAI).
#   twilio — international, or for testing.
SMS_PROVIDER=none
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TEMPLATE_ID=
SMS_ACCOUNT_SID=
SMS_FROM=

# ------------------------------------------------------------ monitoring sink --
# Ship this server's own logs to a Cloudflare Worker (see monitoring/README.md).
#
# OFF by default, and that default is deliberate: a server that starts posting to
# an endpoint somebody typed into a config file without meaning to is a server
# that leaks.
#
# This ships the *server's* logs — latency, errors, provider failures. It is not
# a path for the app's diagnostics, which stay on the device; the sink refuses
# anything carrying a user_code.
LOG_SHIP_ENABLED=false
LOG_SHIP_URL=
LOG_SHIP_TOKEN=
LOG_SHIP_BATCH_SIZE=50
LOG_SHIP_FLUSH_SECONDS=5

# ------------------------------------------------------------------ optional --

# AI providers. Leave unset and the AI endpoints return 503 rather than
# fabricating a result.
ASR_PROVIDER_URL=
ASR_PROVIDER_KEY=
LLM_PROVIDER_URL=
LLM_PROVIDER_KEY=

# ------------------------------------------------------------------- safety ---

# Leave both false in production.
AUTO_CREATE_TABLES=false
OTP_DEBUG_RETURN=false

# The server exits with a list of problems if, in production, any of these hold:
#   - API_TOKEN is empty, a default, or shorter than 24 characters
#   - PHONE_PEPPER is a default or shorter than 16 characters
#   - JWT_SECRET is a default
#   - AUTO_CREATE_TABLES is true
#   - DATABASE_URL points at SQLite
#   - OTP_DEBUG_RETURN is true
#   - ALLOW_SHARED_TOKEN is true
