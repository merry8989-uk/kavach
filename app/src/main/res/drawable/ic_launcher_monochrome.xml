<!--
  Single-colour layer for Android 13+ themed icons.

  The system tints this whole layer one colour, so a filled shield would hide
  anything drawn inside it. Instead the shield is an outline and the handset is
  solid, which keeps both readable when recoloured.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- shield outline -->
    <path
        android:pathData="M54,27 L76,35 L76,55 C76,69.5 67,80.5 54,85.5 C41,80.5 32,69.5 32,55 L32,35 Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5.5"
        android:strokeLineJoin="round"
        android:strokeLineCap="round" />

    <!-- handset, filled -->
